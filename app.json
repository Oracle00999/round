{
  "expo": {
    "name": "ROUND",
    "slug": "round-mobile",
    "scheme": "round",
    "version": "0.4.15",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8F8F2",
    "android": {
      "package": "app.round.savings",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "round",
              "host": "join"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "versionCode": 30,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F8F2",
        "monochromeImage": "./assets/monochrome-icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "name": "ROUND — Save together"
    },
    "plugins": ["expo-dev-client", "expo-notifications", "./plugins/with-reminder-timing"],
    "icon": "./assets/icon.png"
  }
}
