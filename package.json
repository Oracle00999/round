{
  "name": "round-mobile",
  "version": "0.4.15",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contract:build": "sh scripts/contract.sh build",
    "contract:idl": "sh scripts/contract.sh idl",
    "contract:test": "vitest run tests/contract.integration.test.ts",
    "test:rpc": "node --import tsx scripts/rpc-smoke.ts",
    "devnet:prepare": "node --import tsx scripts/devnet.ts prepare",
    "devnet:status": "node --import tsx scripts/devnet.ts status",
    "devnet:deploy": "sh scripts/deploy-devnet.sh",
    "devnet:init": "node --import tsx scripts/devnet.ts init",
    "devnet:fund": "node --import tsx scripts/devnet.ts fund",
    "format": "prettier --write App.tsx src tests scripts docs README.md app.json eas.json tsconfig.json package.json index.js",
    "android:prebuild": "expo prebuild --platform android",
    "test:web": "node scripts/web-smoke.mjs",
    "mainnet:preflight": "node --import tsx scripts/mainnet-preflight.ts",
    "mainnet:deploy": "sh scripts/deploy-mainnet.sh"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@solana-mobile/mobile-wallet-adapter-protocol": "^2.3.0",
    "@solana-mobile/mobile-wallet-adapter-protocol-web3js": "^2.3.0",
    "@solana/spl-token": "^0.4.55",
    "@solana/web3.js": "^1.99.0",
    "buffer": "^6.0.3",
    "expo": "~57.0.24",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-notifications": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-get-random-values": "~1.11.0",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@solana/kit": "^8.3.0",
    "@types/react": "^19.2.0",
    "jsdom": "^30.1.0",
    "litesvm": "^1.4.1",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
